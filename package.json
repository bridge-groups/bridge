{
  "name": "@bridge-groups/bridge",
  "type": "module",
  "license": "MIT",
  "version": "0.0.1",
  "description": "Connect agents to IM, to other agents, and to tools: a library to embed in an app or service, and a CLI for your own machine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridge-groups/bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bridge": "out/cli.js"
  },
  "files": [
    "out",
    "src/examples",
    "doc/config.md",
    "doc/schema.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./local": {
      "types": "./out/local.d.ts",
      "default": "./out/local.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "launch": "node src/cli.ts",
    "output": "tsc -p tsconfig.build.json",
    "suites": "node --test 'src/test/**/*.test.ts'",
    "typeck": "tsc -p tsconfig.json",
    "verify": "npm run typeck && npm run suites"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@canons-dev/canons": "0.2.3",
    "@tsconfig/node-ts": "23.6.5",
    "@tsconfig/node24": "24.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "protobufjs": false
  }
}
