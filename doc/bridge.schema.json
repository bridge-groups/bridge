            "bot_token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "app_token",
            "bot_token"
          ],
          "additionalProperties": false
        },
        "telegram": {
          "type": "object",
          "properties": {
            "bot_token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "bot_token"
          ],
          "additionalProperties": false
