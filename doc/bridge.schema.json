{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "type": "string"
        },
        "port": {
          "default": 7377,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "data_dir": {
          "default": "~/.bridge",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "people": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "trust": {
            "default": "member",
            "type": "string",
            "enum": [
              "owner",
              "trusted",
              "member",
              "agent",
              "external"
            ]
          },
          "slack": {
            "type": "string"
          },
          "telegram": {
            "type": "string"
          },
          "feishu": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "im": {
      "default": {},
      "type": "object",
      "properties": {
        "slack": {
          "type": "object",
          "properties": {
            "app_token": {
              "type": "string",
              "minLength": 1
