    "agents": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "claude-code"
              },
              "command": {
                "default": "claude",
                "type": "string"
              },
              "permission_mode": {
                "default": "default",
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "plan",
                  "bypassPermissions"
                ]
              },
              "allowed_tools": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "worktree": {
                "default": false,
                "type": "boolean"
              },
              "worktree_dir": {
                "default": "~/.bridge/worktrees",
                "type": "string"
              },
              "worktree_links": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "git_token": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "codex"
              },
              "command": {
                "default": "codex",
                "type": "string"
              },
              "sandbox": {
                "default": "workspace-write",
                "type": "string",
                "enum": [
                  "read-only",
                  "workspace-write",
                  "danger-full-access"
                ]
              },
              "cwd": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "worktree": {
                "default": false,
                "type": "boolean"
              },
              "worktree_dir": {
                "default": "~/.bridge/worktrees",
                "type": "string"
              },
              "worktree_links": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "git_token": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "webhook"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout": {
                "default": "10m",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout": {
                "default": "30m",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "command"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "tools": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "default": "mcp",
                "type": "string",
                "const": "mcp"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout": {
                "default": "5m",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "default": "mcp",
                "type": "string",
                "const": "mcp"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "transport": {
                "default": "auto",
                "type": "string",
                "enum": [
                  "auto",
                  "streamable-http",
                  "sse"
                ]
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "oauth": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "const": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "scopes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "client_id": {
                        "type": "string"
                      },
                      "client_secret": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "timeout": {
                "default": "5m",
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "routes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "default": {},
            "type": "object",
            "properties": {
              "mention": {
                "type": [
                  "boolean",
                  "string"
                ]
              },
              "sender": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "anyone"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "policies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "match": {
            "type": "object",
            "properties": {
              "tool": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "writes": {
                "type": "boolean"
              },
              "agent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "approve_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "string"
          },
          "max_hops": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "budget_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "match"
        ],
        "additionalProperties": false
      }
    },
    "defaults": {
      "default": {},
      "type": "object",
      "properties": {
        "dm_idle_reset": {
          "default": "2h",
          "type": "string"
        },
        "offline_queue_ttl": {
          "default": "24h",
          "type": "string"
        },
        "progress": {
          "default": "collapsed",
          "type": "string",
          "enum": [
            "collapsed",
            "verbose",
            "off"
          ]
        },
        "max_hops": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_file_mb": {
          "default": 20,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "files_ttl": {
          "default": "7d",
          "type": "string"
        },
        "worktree_prune_after": {
          "default": "7d",
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string"
            }
          ]
        },
        "retention": {
          "default": "30d",
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z]+:.+$"
              },
              "sender": {
                "type": "string"
              },
              "mention": {
                "default": false,
                "type": "boolean"
              },
              "text": {
                "default": "hello",
                "type": "string"
              },
              "expect": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "calls": {
                "type": "string"
              },
              "expect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny"
                ]
              }
            },
            "required": [
              "agent",
              "calls",
              "expect"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "title": "bridge.yaml"
}
