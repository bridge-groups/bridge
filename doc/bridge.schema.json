        "feishu": {
          "type": "object",
          "properties": {
            "app_id": {
              "type": "string",
              "minLength": 1
            },
            "app_secret": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "default": "feishu",
              "type": "string",
              "enum": [
                "feishu",
                "lark"
              ]
            }
          },
          "required": [
            "app_id",
            "app_secret"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
